{
  "name": "horoscopo-semanal",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --background",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "content": "node --experimental-strip-types --no-warnings scripts/publish-content.ts",
    "content:prune": "node --experimental-strip-types scripts/prune-forecasts.ts",
    "test:unit": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\" \"scripts/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run check && npm run build && playwright test",
    "astro": "astro",
    "social:cards": "node --experimental-strip-types --no-warnings scripts/render-social-cards.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "astro": "^7.1.6",
    "astronomy-engine": "2.1.19",
    "gsap": "^3.15.1",
    "motion": "^14.14.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@playwright/test": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.13"
  }
}
