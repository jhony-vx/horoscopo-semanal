---
interface Breadcrumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Sign slug of the page: highlights its sector and sets its accent color. */
  pageTheme?: string;
  accent?: string;
  pageType?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumbs?: Breadcrumb[];
  /** Extra schema.org nodes for this page, added to the JSON-LD graph. */
  schema?: Record<string, unknown>[];
}

import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import ReadingProgress from '../components/layout/ReadingProgress.astro';
import ScrollToTop from '../components/layout/ScrollToTop.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SkyBackground from '../components/layout/SkyBackground.astro';

const {
  title,
  description,
  noindex = false,
  pageTheme,
  accent,
  pageType = 'website',
  image = '/social/ranking-zodiacal.jpg',
  publishedTime,
  modifiedTime,
  breadcrumbs = [],
  schema = [],
} = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://horoscopo-semanal.pages.dev';
const canonical = new URL(Astro.url.pathname, siteUrl + '/').toString();
const fullTitle = title.includes('Ranking Zodiacal') ? title : title + ' | Ranking Zodiacal';
const socialImage = new URL(image, siteUrl + '/').toString();
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const websiteId = siteUrl + '/#website';
const organizationId = siteUrl + '/#organization';
const webpageId = canonical + '#webpage';
const pageSchema = {
  '@type': pageType === 'article' ? 'Article' : 'WebPage',
  '@id': webpageId,
  name: fullTitle,
  headline: fullTitle,
  description,
  url: canonical,
  image: socialImage,
  inLanguage: 'es-PE',
  isPartOf: { '@id': websiteId },
  author: { '@id': organizationId },
  ...(publishedTime ? { datePublished: publishedTime } : {}),
  ...(modifiedTime ? { dateModified: modifiedTime } : {}),
};
const breadcrumbSchema = breadcrumbs.length > 0
  ? {
      '@type': 'BreadcrumbList',
      '@id': canonical + '#breadcrumbs',
      itemListElement: breadcrumbs.map((breadcrumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: breadcrumb.name,
        item: new URL(breadcrumb.href, siteUrl + '/').toString(),
      })),
    }
  : null;
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Ranking Zodiacal',
      url: siteUrl + '/',
      logo: {
        '@type': 'ImageObject',
        url: new URL('/favicon.svg', siteUrl + '/').toString(),
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'Ranking Zodiacal',
      url: siteUrl + '/',
      inLanguage: 'es-PE',
      publisher: { '@id': organizationId },
    },
    pageSchema,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...schema,
  ],
});
---
<!doctype html>
<html lang="es-PE" data-page-theme={pageTheme} style={accent ? `--sign-accent: ${accent}` : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05070f" />
    <meta name="description" content={description} />
    <meta name="author" content="Ranking Zodiacal" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-PE" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="google-site-verification" content="hDkPnHdWVOOMRBDxOp0w2PIaJL_4EaEZBe6xDdruWmI" />
    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Ranking Zodiacal" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Ranking Zodiacal: horóscopo semanal, diario y mensual" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Ranking Zodiacal: horóscopo semanal, diario y mensual" />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-playfair" preload />
    <title>{fullTitle}</title>
    <script is:inline>
      // Keeps the wheel at the same angle across page loads: 420 s per turn, as --wheel-period.
      document.documentElement.style.setProperty('--wheel-delay', -((Date.now() / 1000) % 420).toFixed(2) + 's');
    </script>
    {analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SkyBackground currentSlug={pageTheme} />
    <ReadingProgress />
    <div class="site-shell">
      <SiteHeader />
      <div class="top-sentinel" data-top-sentinel aria-hidden="true"></div>
      <main id="contenido">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <ScrollToTop />

    <script>
      import { initReveal } from '../scripts/reveal';
      import { initScrollState } from '../scripts/scroll-state';
      import { initShare } from '../scripts/share';
      import { initSignPreference } from '../scripts/sign-preference';

      initSignPreference();
      initShare();
      initScrollState();
      initReveal();
    </script>
  </body>
</html>

<style>
  .site-shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
  }

  .top-sentinel {
    position: absolute;
    top: 0;
    height: 24px;
    width: 1px;
  }
</style>
