---
import FortuneMetrics, { type ScoreData } from './FortuneMetrics.astro';

interface Props {
  label: string;
  dateRange: string;
  dateStart?: string;
  summary?: string;
  data?: ScoreData;
  contentHtml?: string;
}

const { label, dateRange, dateStart, summary, data, contentHtml = '' } = Astro.props;
---

<div class="forecast-panel-content">
  <h3 class="sr-only">{label}</h3>

  <p class="forecast-period-date">
    <span class="eyebrow">Fecha de lectura</span>
    <time datetime={dateStart} data-period-date>{dateRange}</time>
  </p>

  <FortuneMetrics data={data} />

  {summary && (
    <div class="forecast-summary">
      <span class="eyebrow">Breve reseña</span>
      <p>{summary}</p>
    </div>
  )}

  {contentHtml ? (
    <div class="prose forecast-prose">
      <Fragment set:html={contentHtml} />
    </div>
  ) : (
    <div class="empty-state empty-state-compact">
      <h3>Esta lectura está en preparación.</h3>
      <p>Pronto encontrarás aquí una nueva orientación para este periodo.</p>
    </div>
  )}
</div>

<style>
  .forecast-panel-content {
    display: grid;
    gap: 24px;
  }

  .forecast-period-date {
    display: grid;
    gap: 6px;
  }

  .forecast-period-date time {
    font-family: var(--font-display);
    font-size: 1.3rem;
  }

  .forecast-summary {
    display: grid;
    gap: 10px;
    padding: 18px 20px;
    border-left: 2px solid var(--sign-accent);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    background: rgb(255 255 255 / 0.03);
  }

  .forecast-summary p {
    color: var(--ink);
    font-size: 1.08rem;
  }

  .forecast-prose {
    max-width: 72ch;
  }
</style>
