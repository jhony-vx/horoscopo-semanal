---
import type { WeekEntry } from '../../lib/horoscopes';

interface Props {
  week: WeekEntry;
  weekRange: string;
  bodyHtml?: string;
}

const { week, weekRange, bodyHtml = '' } = Astro.props;
---

<section class="weekly-editorial panel" data-reveal aria-labelledby="weekly-editorial-title">
  <header class="weekly-editorial-header">
    <span class="eyebrow">Lectura de la semana</span>
    <h2 id="weekly-editorial-title">{week.data.title}</h2>
    <p class="weekly-editorial-range">{weekRange}</p>
  </header>

  <p class="weekly-editorial-theme">{week.data.theme}</p>
  <p class="weekly-editorial-intro">{week.data.intro}</p>

  {bodyHtml && (
    <div class="weekly-editorial-body prose">
      <Fragment set:html={bodyHtml} />
    </div>
  )}

  <div class="content-note">
    <span>Lectura de entretenimiento. Quédate con lo que te ayude a mirar la semana con más claridad.</span>
    <div class="share-wrap">
      <button class="button button-ghost" type="button" data-share>
        Compartir esta semana <span aria-hidden="true">↗</span>
      </button>
      <span class="share-status" data-share-status aria-live="polite"></span>
    </div>
  </div>
</section>

<style>
  .weekly-editorial {
    display: grid;
    gap: 18px;
    padding: clamp(24px, 4vw, 36px);
  }

  .weekly-editorial-header {
    display: grid;
    gap: 10px;
  }

  .weekly-editorial-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .weekly-editorial-range {
    color: var(--ink-faint);
    font-size: 0.9rem;
  }

  .weekly-editorial-theme {
    color: var(--gold-200);
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .weekly-editorial-intro {
    color: var(--ink);
  }

  .content-note {
    display: grid;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--line-quiet);
    color: var(--ink-faint);
    font-size: 0.88rem;
  }

  .share-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .share-status {
    color: var(--gold-200);
    font-size: 0.86rem;
  }
</style>
