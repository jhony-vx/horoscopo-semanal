---
import RankingCard from './RankingCard.astro';
import { ranksBySign } from '../../lib/editions';
import type { HoroscopeEntry } from '../../lib/horoscopes';

interface Props {
  entries: HoroscopeEntry[];
  /** The previous edition, to show how each sign moved. */
  previousEntries?: HoroscopeEntry[];
  /** Turns off the shared glyph transition, for pages that list the ranking more than once. */
  transition?: boolean;
}

const { entries, previousEntries = [], transition = true } = Astro.props;
const previousRanks = ranksBySign(previousEntries.map((entry) => ({ sign: entry.data.sign, rank: entry.data.rank })));
---

<ol class="weekly-ranking" aria-label="Ranking semanal de los doce signos" data-weekly-ranking>
  {entries.map((entry) => (
    <li class="weekly-ranking-item">
      <RankingCard entry={entry} previousRank={previousRanks.get(entry.data.sign)} transition={transition} />
    </li>
  ))}
</ol>

<style>
  .weekly-ranking {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

<script>
  import { isBelowFold, onceInView, prefersReducedMotion } from '../../scripts/motion-preference';

  // The cards slide in by batches as they reach the viewport; the ones already on screen stay put.
  // GSAP is downloaded only when the ranking gets close, so it never delays the first paint.
  const list = document.querySelector<HTMLElement>('[data-weekly-ranking]');
  const items = list ? Array.from(list.querySelectorAll<HTMLElement>(':scope > li')).filter(isBelowFold) : [];

  if (list && items.length > 0 && !prefersReducedMotion()) {
    items.forEach((item) => (item.style.opacity = '0'));
    onceInView(
      list,
      async () => {
        const modules = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]).catch(() => null);
        if (!modules) {
          // Without the library the cards just show up.
          items.forEach((item) => item.style.removeProperty('opacity'));
          return;
        }
        const [{ gsap }, { ScrollTrigger }] = modules;
        gsap.registerPlugin(ScrollTrigger);
        gsap.set(items, { opacity: 0, x: -24 });
        ScrollTrigger.batch(items, {
          start: 'top 92%',
          once: true,
          onEnter: (batch) => gsap.to(batch, { opacity: 1, x: 0, duration: 0.55, ease: 'power3.out', stagger: 0.06, overwrite: true }),
        });
      },
      '0px 0px 50% 0px',
    );
  }
</script>
