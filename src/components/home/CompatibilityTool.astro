---
import { relationBetween } from '../../zodiac/compatibility';
import SignSelect from '../ui/SignSelect.astro';

const initial = { a: 'aries', b: 'leo' } as const;
const relation = relationBetween(initial.a, initial.b);
---

<section class="compatibility-tool panel" data-compatibility-tool data-reveal aria-labelledby="compatibility-title">
  <div class="compatibility-copy">
    <span class="eyebrow">Compatibilidad</span>
    <h2 id="compatibility-title">¿Cómo se llevan sus signos?</h2>
    <p>Elige dos signos y mira qué dice la rueda de su relación: la distancia entre ellos marca si fluyen, se complementan o se desafían.</p>
  </div>

  <div class="compatibility-form">
    <SignSelect name="a" label="Tu signo" value={initial.a} />
    <span class="compatibility-plus" aria-hidden="true">+</span>
    <SignSelect name="b" label="Su signo" value={initial.b} align="end" />
  </div>

  <output class="compatibility-result" data-compatibility-result aria-live="polite">
    <svg class="compatibility-ring" viewBox="0 0 120 120" aria-hidden="true">
      <circle class="ring-track" cx="60" cy="60" r="52" pathLength="100" />
      <circle class="ring-value" cx="60" cy="60" r="52" pathLength="100" style={`stroke-dashoffset: ${100 - relation.score}`} data-ring />
    </svg>
    <span class="compatibility-score"><span data-score>{relation.score}</span><small>%</small></span>
    <span class="compatibility-label" data-label>{relation.label}</span>
    <span class="compatibility-text" data-text>{relation.text}</span>
  </output>

</section>

<style>
  .compatibility-tool {
    display: grid;
    gap: 28px;
    padding: clamp(24px, 5vw, 48px);
    background:
      radial-gradient(circle at 85% 20%, rgb(226 184 101 / 0.12), transparent 55%),
      var(--surface);
  }

  @media (min-width: 960px) {
    .compatibility-tool {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }

    .compatibility-result {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  .compatibility-copy {
    display: grid;
    gap: 12px;
  }

  .compatibility-copy h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .compatibility-copy p {
    color: var(--ink-soft);
  }

  .compatibility-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: end;
    gap: 12px;
  }

  .compatibility-plus {
    padding-bottom: 14px;
    color: var(--gold-300);
    font-size: 1.4rem;
  }

  @media (max-width: 480px) {
    .compatibility-form {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 10px;
    }

    .compatibility-plus {
      display: none;
    }
  }

  .compatibility-result {
    display: grid;
    justify-items: center;
    gap: 8px;
    text-align: center;
  }

  .compatibility-ring {
    grid-area: 1 / 1;
    width: 180px;
    rotate: -90deg;
  }

  .compatibility-score {
    grid-area: 1 / 1;
    align-self: center;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .compatibility-score small {
    font-size: 0.5em;
  }

  .ring-track,
  .ring-value {
    fill: none;
    stroke-width: 6;
  }

  .ring-track {
    stroke: rgb(255 255 255 / 0.08);
  }

  .ring-value {
    stroke: var(--gold-300);
    stroke-dasharray: 100;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px rgb(226 184 101 / 0.5));
  }

  .compatibility-label {
    color: var(--gold-200);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
  }

  .compatibility-text {
    max-width: 40ch;
    color: var(--ink-soft);
  }
</style>

<script>
  import { animate } from 'motion/mini';
  import { relationBetween } from '../../zodiac/compatibility';
  import { getSign, type SignSlug } from '../../zodiac/signs';
  import { EASE_OUT, prefersReducedMotion } from '../../scripts/motion-preference';
  import { readSavedSign } from '../../scripts/sign-preference';

  /** Counts the number up or down with an ease-out, one frame at a time. */
  function countTo(element: HTMLElement, from: number, to: number, duration = 600): void {
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min(1, (now - start) / duration);
      element.textContent = String(Math.round(from + (to - from) * (1 - (1 - progress) ** 3)));
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  document.querySelectorAll<HTMLElement>('[data-compatibility-tool]').forEach((tool) => {
    const [first, second] = Array.from(tool.querySelectorAll<HTMLElement>('[data-sign-select]'));
    const ring = tool.querySelector<SVGCircleElement>('[data-ring]')!;
    const score = tool.querySelector<HTMLElement>('[data-score]')!;
    const label = tool.querySelector<HTMLElement>('[data-label]')!;
    const text = tool.querySelector<HTMLElement>('[data-text]')!;
    let shown = Number(score.textContent);

    const update = () => {
      const relation = relationBetween(first.dataset.value as SignSlug, second.dataset.value as SignSlug);
      label.textContent = relation.label;
      text.textContent = relation.text;
      const offset = String(100 - relation.score);
      if (prefersReducedMotion()) {
        score.textContent = String(relation.score);
        ring.style.strokeDashoffset = offset;
      } else {
        countTo(score, shown, relation.score);
        animate(ring, { strokeDashoffset: [getComputedStyle(ring).strokeDashoffset, offset] }, { duration: 0.6, ease: EASE_OUT }).then(() => (ring.style.strokeDashoffset = offset));
        animate([label, text], { opacity: [0, 1], translate: ['0 6px', '0 0'] }, { duration: 0.3 });
      }
      shown = relation.score;
    };

    const saved = readSavedSign();
    first.addEventListener('sign-change', update);
    second.addEventListener('sign-change', update);
    // DOMContentLoaded fires after every module script ran, so the select is listening by then.
    if (saved && getSign(saved)) {
      document.addEventListener('DOMContentLoaded', () => first.dispatchEvent(new CustomEvent('sign-set', { detail: saved })), { once: true });
    }
  });
</script>
