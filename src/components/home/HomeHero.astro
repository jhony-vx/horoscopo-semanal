---
import type { ZodiacSign } from '../../zodiac/signs';

interface Props {
  weekRange: string;
  theme: string;
  leader?: ZodiacSign;
}

const { weekRange, theme, leader } = Astro.props;
---

<section class="hero">
  <div class="container hero-inner">
    <span class="eyebrow hero-intro" style="--intro-order: 0">Edición semanal</span>
    <h1 class="hero-title hero-intro" style="--intro-order: 1">Tu semana,<br /><em>en perspectiva.</em></h1>
    <p class="hero-description hero-intro" style="--intro-order: 2">
      El ranking de los doce signos, calculado cada semana con la posición real del Sol, la Luna y los planetas.
    </p>
    <div class="hero-actions hero-intro" style="--intro-order: 3">
      <a class="button button-primary" href="#ranking">Ver el ranking <span aria-hidden="true">↓</span></a>
      <a class="button button-ghost" href="#tu-signo">Elegir mi signo <span aria-hidden="true">→</span></a>
    </div>

    <dl class="hero-facts hero-intro" style="--intro-order: 4" aria-label="Información de la edición">
      <div class="hero-fact">
        <dt>Semana editorial</dt>
        <dd class="week-range">{weekRange}</dd>
      </div>
      {leader && (
        <div class="hero-fact" style={`--orb-accent: ${leader.accent}`}>
          <dt>Lidera la semana</dt>
          <dd><span class="symbol hero-leader-symbol" aria-hidden="true">{leader.symbol}</span> {leader.name}</dd>
        </div>
      )}
      <div class="hero-fact hero-fact-wide">
        <dt>Tema</dt>
        <dd class="week-theme">{theme}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    display: grid;
    min-height: min(calc(100svh - 72px), 900px);
    padding-block: clamp(48px, 9vh, 120px) 56px;
    text-align: center;
  }

  .hero-inner {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 22px;
  }

  .hero-title {
    font-size: clamp(2.9rem, 9vw, 6.2rem);
    font-weight: 700;
    line-height: 1.02;
    text-shadow: var(--text-shadow);
  }

  .hero-title em {
    background: linear-gradient(100deg, var(--gold-200), var(--gold-400) 55%, var(--gold-200));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: normal;
    text-shadow: none;
  }

  .hero-description {
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    text-shadow: var(--text-shadow);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    width: min(760px, 100%);
    margin: 18px 0 0;
  }

  .hero-fact {
    display: grid;
    gap: 4px;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    text-align: left;
  }

  .hero-fact-wide {
    grid-column: 1 / -1;
  }

  .hero-fact dt {
    color: var(--ink-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-fact dd {
    margin: 0;
    font-weight: 600;
  }

  .hero-fact .week-theme {
    font-family: var(--font-display);
    font-size: 1.08rem;

    font-weight: 600;
  }

  .hero-leader-symbol {
    color: var(--orb-accent);
  }

  @media (min-width: 760px) {
    .hero-facts {
      grid-template-columns: 1fr 1fr 2fr;
    }

    .hero-fact-wide {
      grid-column: auto;
    }
  }

  /* CSS entrance: it runs on first paint, before any script loads. */
  .hero-intro {
    animation: hero-rise 700ms var(--ease-out) both;
    animation-delay: calc(var(--intro-order) * 90ms);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }
</style>
