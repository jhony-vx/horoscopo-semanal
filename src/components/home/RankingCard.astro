---
import { getSign } from '../../zodiac/signs';
import type { HoroscopeEntry } from '../../lib/horoscopes';
import { movementDescription, movementLabel, rankMovement } from '../../lib/editions';
import SignLogo from '../ui/SignLogo.astro';

interface Props {
  entry: HoroscopeEntry;
  /** Rank in the previous edition, to show the trend. */
  previousRank?: number;
  /** Shares the glyph with the sign page during a view transition (only one card per sign on a page). */
  transition?: boolean;
}

const PODIUM = ['gold', 'silver', 'bronze'] as const;

const { entry, previousRank, transition = true } = Astro.props;
const sign = getSign(entry.data.sign);
if (!sign) throw new Error('Signo no encontrado: ' + entry.data.sign);
const { rank, generalScore } = entry.data;
const medal = PODIUM[rank - 1];
const movement = rankMovement(rank, previousRank);
const trend = movementLabel(movement);
---

<a class="ranking-card" href={'/horoscopo/' + sign.slug + '/'} data-element={sign.elementKey} data-medal={medal} style={`--orb-accent: ${sign.accent}`}>
  <span class="ranking-rank">
    <span class="ranking-position" aria-label={'Puesto ' + rank}>{String(rank).padStart(2, '0')}</span>
    {trend && (
      <span class="ranking-trend" data-trend={movement.kind} title={movementDescription(movement)}>
        <span aria-hidden="true">{trend}</span>
        <span class="sr-only">{movementDescription(movement)}</span>
      </span>
    )}
  </span>
  <SignLogo sign={sign} size="small" decorative transitionName={transition ? 'sign-' + sign.slug : undefined} />
  <span class="ranking-heading">
    <span class="ranking-name">{sign.name}</span>
    <span class="ranking-element">{sign.element}</span>
  </span>
  <span class="ranking-score" aria-label={`Suerte de la semana: ${generalScore} de 5`}>
    <span class="ranking-stars" aria-hidden="true">
      {[1, 2, 3, 4, 5].map((step) => <span class:list={['ranking-star', step <= generalScore && 'is-on']}>★</span>)}
    </span>
    <span class="ranking-score-label" aria-hidden="true">Suerte {generalScore}/5</span>
  </span>
  <span class="ranking-summary">{entry.data.summary}</span>
</a>

<style>
  .ranking-card {
    --medal: var(--line-strong);
    position: relative;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    grid-template-areas:
      'rank orb heading score'
      'rank orb summary score';
    align-items: center;
    column-gap: 16px;
    row-gap: 4px;
    padding: 16px 20px;
    border: 1px solid var(--line-quiet);
    border-radius: var(--radius-card);
    background: var(--surface);
    text-decoration: none;
    transition:
      border-color var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .ranking-card[data-medal='gold'] {
    --medal: #f2d38a;
  }

  .ranking-card[data-medal='silver'] {
    --medal: #cfd5e4;
  }

  .ranking-card[data-medal='bronze'] {
    --medal: #d9a07a;
  }

  .ranking-card:hover,
  .ranking-card:focus-visible {
    border-color: color-mix(in srgb, var(--orb-accent) 45%, transparent);
    background: color-mix(in srgb, var(--orb-accent) 6%, var(--surface));
    box-shadow: 0 18px 44px rgb(0 0 0 / 0.38);
  }

  .ranking-rank {
    grid-area: rank;
    display: grid;
    justify-items: center;
    gap: 4px;
  }

  .ranking-trend {
    min-width: 28px;
    padding: 1px 6px;
    border-radius: var(--radius-control);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .ranking-trend[data-trend='up'] {
    background: rgb(126 217 154 / 0.14);
    color: #8fe0a8;
  }

  .ranking-trend[data-trend='down'] {
    background: rgb(255 128 128 / 0.12);
    color: #ff9b9b;
  }

  .ranking-trend[data-trend='same'] {
    background: rgb(255 255 255 / 0.06);
    color: var(--ink-faint);
  }

  .ranking-position {
    display: grid;
    place-items: center;
    width: 40px;
    aspect-ratio: 1;
    border: 1px solid var(--medal);
    border-radius: 50%;
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  [data-medal] .ranking-position {
    border-width: 1.5px;
    background: color-mix(in srgb, var(--medal) 14%, transparent);
    color: var(--medal);
    box-shadow: 0 0 16px color-mix(in srgb, var(--medal) 25%, transparent);
  }

  .ranking-card > :global(.sign-logo) {
    grid-area: orb;
  }

  .ranking-heading {
    grid-area: heading;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
  }

  .ranking-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .ranking-element {
    color: var(--element-color);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ranking-summary {
    grid-area: summary;
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .ranking-score {
    grid-area: score;
    display: grid;
    justify-items: end;
    gap: 2px;
    padding-left: 8px;
  }

  .ranking-stars {
    display: flex;
    gap: 2px;
    font-size: 0.95rem;
    line-height: 1;
  }

  .ranking-star {
    color: rgb(255 255 255 / 0.14);
  }

  .ranking-star.is-on {
    color: var(--gold-300);
  }

  .ranking-score-label {
    color: var(--ink-faint);
    font-size: 0.76rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Mobile: the summary takes the full width under the heading instead of a narrow column. */
  @media (max-width: 600px) {
    .ranking-card {
      grid-template-columns: auto auto minmax(0, 1fr);
      grid-template-areas:
        'rank orb heading'
        'rank orb score'
        'summary summary summary';
      column-gap: 12px;
      row-gap: 2px;
      padding: 14px 16px 16px;
    }

    .ranking-position {
      width: 34px;
      font-size: 1rem;
    }

    .ranking-name {
      font-size: 1.15rem;
    }

    .ranking-score {
      display: flex;
      align-items: center;
      justify-items: start;
      gap: 8px;
      padding-left: 0;
    }

    .ranking-summary {
      margin-top: 10px;
      font-size: 0.92rem;
      -webkit-line-clamp: 3;
    }
  }
</style>
