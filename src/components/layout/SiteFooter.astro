---
import BrandMark from './BrandMark.astro';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-about">
      <BrandMark label="Ranking Zodiacal, volver al inicio" />
      <p>Una lectura semanal para mirar tus días con curiosidad y buena energía, calculada con las posiciones reales del cielo.</p>
    </div>
    <nav class="footer-links" aria-label="Enlaces del pie de página">
      <a href="/#ranking">Ver ranking</a>
      <a href="/#tu-signo">Elegir mi signo</a>
      <a href="/semanas/">Historial de ediciones</a>
      <a href="/calendario-lunar/">Calendario lunar</a>
    </nav>
    <p class="footer-disclaimer">Contenido de entretenimiento. No reemplaza asesoría médica, legal, financiera ni profesional.</p>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Ranking Zodiacal</span>
    <span>Rueda zodiacal y símbolos propios de Ranking Zodiacal</span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: 48px;
    border-top: 1px solid var(--line-quiet);
    background: rgb(5 7 15 / 0.88);
  }

  .footer-grid {
    display: grid;
    gap: 28px;
    padding-block: 48px 28px;
  }

  .footer-about {
    display: grid;
    gap: 14px;
    max-width: 44ch;
  }

  .footer-about p,
  .footer-disclaimer {
    color: var(--ink-faint);
    font-size: 0.92rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .footer-links a {
    color: var(--ink-soft);
    font-weight: 600;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--gold-200);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 20px 32px;
    border-top: 1px solid var(--line-quiet);
    color: var(--ink-faint);
    font-size: 0.82rem;
  }

  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1.2fr;
      align-items: start;
    }
  }
</style>
