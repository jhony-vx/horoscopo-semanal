---
interface Props {
  tagline?: boolean;
  label: string;
}

const { tagline = false, label } = Astro.props;
---

<a class="brand" href="/" aria-label={label}>
  <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="18.5" />
    <circle cx="20" cy="20" r="12.5" />
    <path d="M20 1.5v6M20 32.5v6M1.5 20h6M32.5 20h6M6.9 6.9l4.2 4.2M28.9 28.9l4.2 4.2M6.9 33.1l4.2-4.2M28.9 11.1l4.2-4.2" />
    <path class="brand-star" d="M20 13l1.8 5.2L27 20l-5.2 1.8L20 27l-1.8-5.2L13 20l5.2-1.8z" />
  </svg>
  <span class="brand-copy">
    <span class="brand-name">Ranking Zodiacal</span>
    {tagline && <span class="brand-tagline">Tu semana, en perspectiva</span>}
  </span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    fill: none;
    stroke: var(--gold-300);
    stroke-width: 1.2;
    transition: rotate 900ms var(--ease-out);
  }

  .brand:hover .brand-mark {
    rotate: 30deg;
  }

  .brand-star {
    fill: var(--gold-300);
    stroke: none;
  }

  .brand-copy {
    display: grid;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .brand-tagline {
    color: var(--ink-faint);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
  }
</style>
