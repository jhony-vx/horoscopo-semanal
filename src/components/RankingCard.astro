---
import { getSign } from '../data-signs';
import type { HoroscopeEntry } from '../lib/horoscopes';
import SignLogo from './SignLogo.astro';

interface Props {
  entry: HoroscopeEntry;
}

const { entry } = Astro.props;
const sign = getSign(entry.data.sign);
if (!sign) throw new Error('Signo no encontrado: ' + entry.data.sign);
---

<a
  class="ranking-card"
  href={'/horoscopo/' + sign.slug + '/'}
  data-element={sign.elementKey}
  data-spotlight
>
  <span class="ranking-position" aria-label={'Puesto ' + entry.data.rank}>{String(entry.data.rank).padStart(2, '0')}</span>
  <SignLogo sign={sign} size="small" decorative />
  <span class="ranking-content">
    <span class="ranking-name">{sign.name}</span>
    <span class="ranking-meta">
      <span class="ranking-element">{sign.element}</span>
      <span class="ranking-summary">{entry.data.summary}</span>
    </span>
  </span>
  <span class="ranking-arrow" aria-hidden="true">↗</span>
</a>
