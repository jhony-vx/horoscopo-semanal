---
import { ZODIAC_SIGNS, getSign, type ZodiacSign } from '../../data-signs';
import ForecastTabs from '../../components/ForecastTabs.astro';
import SignLogo from '../../components/SignLogo.astro';
import SignPickerDialog from '../../components/SignPickerDialog.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { currentDateInLima, dateInLima, formatWeekRange, getCurrentEdition, getForecastsForSign, type HoroscopeEntry } from '../../lib/horoscopes';

export async function getStaticPaths() {
  const edition = await getCurrentEdition();
  const forecasts = await Promise.all(ZODIAC_SIGNS.map((sign) => getForecastsForSign(sign.slug)));

  return ZODIAC_SIGNS.map((sign, index) => ({
    params: { signo: sign.slug },
    props: {
      sign,
      edition,
      entry: edition?.entries.find((entry) => entry.data.sign === sign.slug),
      forecasts: forecasts[index],
    },
  }));
}

interface Props {
  sign: ZodiacSign;
  edition: Awaited<ReturnType<typeof getCurrentEdition>>;
  entry?: HoroscopeEntry;
  forecasts: Awaited<ReturnType<typeof getForecastsForSign>>;
}

const { sign, edition, entry, forecasts } = Astro.props;
const weekRange = edition ? formatWeekRange(edition.week.data.weekStart, edition.week.data.weekEnd) : '';
const todayDate = currentDateInLima();
const tomorrowDate = dateInLima(1);
const nearbyEntries = edition?.entries.filter((item) => item.data.sign !== sign.slug).slice(0, 4) ?? [];
---

<SiteLayout
  title={'Horóscopo diario y semanal de ' + sign.name}
  pageTheme={sign.slug}
  themeColor={sign.themeColor}
  pageType="article"
  publishedTime={edition?.week.data.weekStart}
  modifiedTime={edition?.week.data.weekEnd}
  breadcrumbs={[{ name: 'Inicio', href: '/' }, { name: sign.name, href: '/horoscopo/' + sign.slug + '/' }]}
  description={'Lee el horóscopo diario, semanal y mensual de ' + sign.name + ', su posición en el ranking y una lectura por periodo.'}
>
  <div class="sign-page" data-sign={sign.slug} data-element={sign.elementKey}>
    <section class="sign-hero" data-reveal>
      <div class="container">
        <nav class="breadcrumb" aria-label="Migas de pan">
          <a href="/">Ranking semanal</a>
          <span aria-hidden="true">/</span>
          <span>{sign.name}</span>
        </nav>

        <div class="sign-hero-grid">
          <div class="sign-hero-logo">
            <SignLogo sign={sign} size="large" />
          </div>
          <div class="sign-hero-copy">
            <span class="eyebrow">Lectura de {sign.element.toLowerCase()}</span>
            <h1>{sign.name}</h1>
            <p class="sign-hero-meta">{sign.element} / {sign.dateRange}</p>
            <p class="sign-hero-description">Una lectura de entretenimiento para observar tus decisiones, tus vínculos y el ritmo de tus próximos días.</p>
            <SignPickerDialog currentSlug={sign.slug} />
          </div>
          <aside class="sign-rank-card" data-reveal data-spotlight aria-label="Posición semanal">
            <span class="rank-card-label">Ranking semanal</span>
            <strong>{entry ? String(entry.data.rank).padStart(2, '0') : 'N/D'}</strong>
            <span>{entry ? 'puesto de ' + sign.name : 'lectura en preparación'}</span>
          </aside>
        </div>
      </div>
    </section>

    <section class="section sign-reading-section" data-reveal>
      <div class="container">
        <ForecastTabs
          weeklyEntry={entry}
          today={forecasts.today}
          tomorrow={forecasts.tomorrow}
          month={forecasts.month}
          weekRange={weekRange}
          todayDate={todayDate}
          tomorrowDate={tomorrowDate}
        />
      </div>
    </section>

    <section class="section sign-discovery-section" data-reveal>
      <div class="container sign-discovery-grid">
        <div>
          <span class="eyebrow">Sigue explorando</span>
          <h2>Otros signos también tienen algo que decir.</h2>
          <p>Compara lecturas y vuelve al ranking general cuando quieras.</p>
        </div>
        <div class="sidebar-signs">
          {nearbyEntries.map((item) => {
            const nearbySign = getSign(item.data.sign);
            return nearbySign && (
              <a href={'/horoscopo/' + nearbySign.slug + '/'} data-element={nearbySign.elementKey}>
                <SignLogo sign={nearbySign} size="small" decorative />
                <span>{nearbySign.name}</span>
              </a>
            );
          })}
        </div>
        <a class="button button-ghost discovery-return" href="/">Volver al ranking <span aria-hidden="true">↩</span></a>
      </div>
    </section>
  </div>
</SiteLayout>
