---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Página no encontrada" description="La página que buscas no existe." noindex>
  <div class="container">
    <section class="empty-state">
      <span class="eyebrow">404 · Ruta no encontrada</span>
      <h1>Esta estrella se salió de la órbita.</h1>
      <p>La página que buscas no está disponible, pero el ranking semanal sí te está esperando.</p>
      <a class="button button-primary" href="/" style="margin-top: 24px;">Volver al inicio <span aria-hidden="true">→</span></a>
    </section>
  </div>
</SiteLayout>
