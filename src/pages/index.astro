---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import WeeklyEditorial from '../components/home/WeeklyEditorial.astro';
import WeeklyRanking from '../components/home/WeeklyRanking.astro';
import SignGrid from '../components/shared/SignGrid.astro';
import { formatWeekRange, getCurrentEdition } from '../lib/horoscopes';
import { getSign } from '../zodiac/signs';

const edition = await getCurrentEdition();
const weekRange = edition ? formatWeekRange(edition.week.data.weekStart, edition.week.data.weekEnd) : '';
const leader = edition ? getSign(edition.entries[0].data.sign) : undefined;
---

<SiteLayout
  title="Horóscopo semanal, diario y ranking zodiacal"
  description="Descubre el ranking del horóscopo semanal y consulta las lecturas diarias, semanales y mensuales de los 12 signos."
>
  {edition ? (
    <>
      <HomeHero weekRange={weekRange} theme={edition.week.data.theme} leader={leader} />

      <section class="section" id="ranking">
        <div class="container">
          <div class="section-heading" data-reveal>
            <div>
              <span class="eyebrow">El pulso de los astros</span>
              <h2>Ranking semanal</h2>
            </div>
            <p>Del puesto 1 al 12, según cómo el cielo de esta semana acompaña a cada signo. Toca uno para leer su horóscopo completo.</p>
          </div>

          <div class="ranking-layout">
            <WeeklyRanking entries={edition.entries} />
            <aside class="ranking-aside">
              <WeeklyEditorial week={edition.week} weekRange={weekRange} bodyHtml={edition.week.rendered?.html ?? ''} />
            </aside>
          </div>
        </div>
      </section>

      <section class="section" id="tu-signo">
        <div class="container">
          <div class="section-heading" data-reveal>
            <div>
              <span class="eyebrow">Tu lectura personal</span>
              <h2>Encuentra tu signo.</h2>
            </div>
            <p>Elige un signo para consultar su horóscopo diario, semanal y mensual. Lo recordaremos en este dispositivo.</p>
          </div>
          <SignGrid />
        </div>
      </section>
    </>
  ) : (
    <div class="container">
      <section class="empty-state panel">
        <h1>La próxima lectura está tomando forma.</h1>
        <p>Estamos preparando una nueva edición semanal. Vuelve pronto para descubrir el ranking de los doce signos.</p>
      </section>
    </div>
  )}
</SiteLayout>

<style>
  .ranking-layout {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 1000px) {
    .ranking-layout {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      align-items: start;
      gap: 32px;
    }

    .ranking-aside {
      position: sticky;
      top: 96px;
    }
  }
</style>
