---
import SiteLayout from '../layouts/SiteLayout.astro';
import SignGrid from '../components/SignGrid.astro';
import WeeklyEditorial from '../components/WeeklyEditorial.astro';
import WeeklyRanking from '../components/WeeklyRanking.astro';
import { formatWeekRange, getCurrentEdition } from '../lib/horoscopes';

const edition = await getCurrentEdition();
const weekRange = edition ? formatWeekRange(edition.week.data.weekStart, edition.week.data.weekEnd) : '';
---

<SiteLayout
  title="Horóscopo semanal, diario y ranking zodiacal"
  description="Descubre el ranking del horóscopo semanal y consulta las lecturas diarias, semanales y mensuales de los 12 signos."
>
  {edition ? (
    <>
      <section class="hero" data-reveal>
        <div class="container hero-grid">
          <div class="hero-copy">
            <span class="eyebrow">Edición semanal</span>
            <h1>Tu semana,<br /><em>en perspectiva.</em></h1>
            <p class="hero-description">Una guía breve para saber qué energía acompaña a cada signo. Explora el ranking y encuentra tu lectura.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#ranking">Ver el ranking <span aria-hidden="true">↓</span></a>
              <a class="button button-ghost" href="#tu-signo">Elegir mi signo <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <aside class="hero-aside" data-spotlight aria-label="Información de la edición">
            <span class="aside-label">Semana editorial</span>
            <strong class="week-range">{weekRange}</strong>
            <p class="week-theme">{edition.week.data.theme}</p>
          </aside>
        </div>
      </section>

      <section class="section ranking-section" id="ranking" data-reveal>
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="eyebrow">El pulso de los astros</span>
              <h2>Ranking semanal</h2>
            </div>
            <p>Consulta el ranking del horóscopo semanal y explora las tendencias de cada signo con curiosidad y criterio.</p>
          </div>

          <WeeklyRanking entries={edition.entries} />
          <WeeklyEditorial
            week={edition.week}
            weekRange={weekRange}
            bodyHtml={edition.week.rendered?.html ?? ''}
          />
        </div>
      </section>

      <section class="selector-section" id="tu-signo" data-reveal>
        <div class="container">
          <div class="selector-heading">
            <span class="eyebrow">Tu lectura personal</span>
            <h2>Encuentra tu signo.</h2>
            <p>Elige un signo para consultar su horóscopo diario, semanal y mensual, y guardar la preferencia en este dispositivo.</p>
          </div>
          <SignGrid />
        </div>
      </section>
    </>
  ) : (
    <div class="container">
      <section class="empty-state">
        <h1>La próxima lectura está tomando forma.</h1>
        <p>Estamos preparando una nueva edición semanal. Vuelve pronto para descubrir el ranking de los doce signos.</p>
      </section>
    </div>
  )}
</SiteLayout>
